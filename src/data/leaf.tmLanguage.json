{
  "name": "leaf",
  "scopeName": "source.leaf",
  "patterns": [
    { "include": "#comment" },
    { "include": "#annotation" },
    { "include": "#interpolated-string" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constructor" },
    { "include": "#type" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.documentation.leaf",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.leaf",
          "match": "//.*$"
        },
        {
          "name": "comment.block.leaf",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotation": {
      "name": "entity.name.function.decorator.leaf",
      "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
    },
    "interpolated-string": {
      "name": "string.quoted.double.leaf",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.template.expression.leaf",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#number" },
            { "include": "#constructor" },
            { "include": "#operator" }
          ]
        },
        { "name": "constant.character.escape.leaf", "match": "\\\\." }
      ]
    },
    "string": {
      "name": "string.quoted.double.leaf",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.leaf", "match": "\\\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.leaf",
      "match": "\\b\\d[\\d_]*(\\.\\d+)?\\b"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.leaf" },
            "2": { "name": "entity.name.function.leaf" }
          }
        },
        {
          "match": "\\b(struct|enum|trait|impl)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.leaf" },
            "2": { "name": "entity.name.type.leaf" }
          }
        },
        {
          "match": "\\b(let|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.leaf" },
            "2": { "name": "variable.other.leaf" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.leaf",
          "match": "\\b(if|else|match|for|in|while|break|continue|return|try|is|super)\\b"
        },
        {
          "name": "keyword.control.import.leaf",
          "match": "\\b(import|export|from)\\b"
        },
        {
          "name": "keyword.declaration.leaf",
          "match": "\\b(let|const|def|struct|enum|trait|impl)\\b"
        },
        {
          "name": "variable.language.self.leaf",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.leaf",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "constructor": {
      "name": "variable.other.enummember.leaf",
      "match": "\\b(Some|None|Ok|Err)\\b"
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.primitive.leaf",
          "match": "\\b(int|float|bool|string|void)\\b"
        },
        {
          "name": "support.type.leaf",
          "match": "\\b(Option|Result|Array|Map|Func|Closure|ArrayBuilder|MapBuilder|Default|Self)\\b"
        },
        {
          "name": "entity.name.type.leaf",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.function.call.leaf" }
      }
    },
    "operator": {
      "name": "keyword.operator.leaf",
      "match": "(\\?\\.|\\?\\?|\\?\\(|\\.\\.\\.|->|=>|[+\\-*/%<>=!]=?|\\?)"
    }
  }
}
